# כתובת האתר הציבורית (בלי סלאש בסוף) - חשוב לתצוגה המקדימה בוואטסאפ
BASE_URL=http://localhost:3000

# פורט הרצת השרת
PORT=3000

# סיסמת הכניסה לפאנל הניהול - תבחר סיסמה חזקה משלך
ADMIN_PASSWORD=change-me-please

# מפתח סודי להצפנת ה-session (מחרוזת אקראית ארוכה כלשהי)
SESSION_SECRET=change-this-to-a-long-random-string

# פרטי חשבון SMS4Free (מתקבלים אחרי הרשמה באתר sms4free.co.il)
SMS4FREE_KEY=
SMS4FREE_USER=
SMS4FREE_PASS=
SMS4FREE_SENDER=Wedding
